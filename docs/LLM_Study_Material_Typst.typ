# Production Drift Detection System

import numpy as np
from scipy.stats import wasserstein_distance
from scipy.spatial.distance import jensenshannon
from typing import List, Dict
import torch

class DriftDetector:
    """
    Detect distribution drift in production LLM inputs.

    Supports multiple drift metrics:
    - KL Divergence
    - Population Stability Index (PSI)
    - Wasserstein Distance (embedding space)
    """

    def __init__(self, baseline_samples: List[str], model, tokenizer):
        """
        Initialize drift detector with baseline (training) distribution.

        Args:
            baseline_samples: Representative samples from training data
            model: LLM for computing embeddings
            tokenizer: Corresponding tokenizer
        """
        self.baseline_samples = baseline_samples
        self.model = model
        self.tokenizer = tokenizer

        # Compute baseline statistics
        self.baseline_token_dist = self._compute_token_distribution(baseline_samples)
        self.baseline_embeddings = self._compute_embeddings(baseline_samples)

    def _compute_token_distribution(self, samples: List[str]) -> Dict[str, float]:
        """
        Compute token frequency distribution.

        Returns dict mapping token -> probability.
        """
        token_counts = {}
        total_tokens = 0

        for sample in samples:
            tokens = self.tokenizer.tokenize(sample)
            for token in tokens:
                token_counts[token] = token_counts.get(token, 0) + 1
                total_tokens += 1

        # Convert counts to probabilities
        token_dist = {token: count / total_tokens
                      for token, count in token_counts.items()}

        return token_dist

    def _compute_embeddings(self, samples: List[str]) -> np.ndarray:
        """
        Compute sentence embeddings using model's last hidden state.

        Returns (n_samples, hidden_dim) array.
        """
        embeddings = []

        for sample in samples:
            inputs = self.tokenizer(sample, return_tensors="pt",
                                     truncation=True, max_length=512)

            with torch.no_grad():
                outputs = self.model(**inputs, output_hidden_states=True)
                # Use mean of last hidden state as sentence embedding
                embedding = outputs.hidden_states[-1].mean(dim=1).squeeze()
                embeddings.append(embedding.cpu().numpy())

        return np.array(embeddings)

    def compute_kl_divergence(self, production_samples: List[str]) -> float:
        """
        Compute KL divergence between baseline and production token distributions.

        Returns D_KL(baseline || production).
        """
        prod_dist = self._compute_token_distribution(production_samples)

        # Get union of all tokens (with smoothing)
        all_tokens = set(self.baseline_token_dist.keys()) | set(prod_dist.keys())

        # Add Laplace smoothing to avoid log(0)
        smoothing = 1e-10
        kl_div = 0.0

        for token in all_tokens:
            p = self.baseline_token_dist.get(token, 0) + smoothing
            q = prod_dist.get(token, 0) + smoothing

            kl_div += p * np.log(p / q)

        return kl_div

    def compute_psi(self, production_samples: List[str], n_bins: int = 10) -> float:
        """
        Compute Population Stability Index (PSI).

        Bins token frequency distributions and compares.
        """
        prod_dist = self._compute_token_distribution(production_samples)

        # Get token frequency arrays
        all_tokens = list(set(self.baseline_token_dist.keys()) | set(prod_dist.keys()))

        baseline_freqs = np.array([self.baseline_token_dist.get(t, 0)
                                    for t in all_tokens])
        prod_freqs = np.array([prod_dist.get(t, 0) for t in all_tokens])

        # Create bins based on baseline distribution
        bins = np.linspace(0, max(baseline_freqs.max(), prod_freqs.max()), n_bins + 1)

        # Bin the distributions
        baseline_binned, _ = np.histogram(baseline_freqs, bins=bins)
        prod_binned, _ = np.histogram(prod_freqs, bins=bins)

        # Normalize to probabilities
        baseline_binned = baseline_binned / baseline_binned.sum()
        prod_binned = prod_binned / prod_binned.sum()

        # Compute PSI
        psi = 0.0
        for i in range(n_bins):
            if baseline_binned[i] > 0 and prod_binned[i] > 0:
                psi += (prod_binned[i] - baseline_binned[i]) * \
                       np.log(prod_binned[i] / baseline_binned[i])

        return psi

    def compute_embedding_drift(self, production_samples: List[str]) -> float:
        """
        Compute Wasserstein distance between embedding distributions.

        Uses 2D PCA projection for computational efficiency.
        """
        from sklearn.decomposition import PCA

        # Compute production embeddings
        prod_embeddings = self._compute_embeddings(production_samples)

        # Combine and project to 2D for tractable Wasserstein computation
        all_embeddings = np.vstack([self.baseline_embeddings, prod_embeddings])
        pca = PCA(n_components=2)
        all_projected = pca.fit_transform(all_embeddings)

        n_baseline = len(self.baseline_embeddings)
        baseline_projected = all_projected[:n_baseline]
        prod_projected = all_projected[n_baseline:]

        # Compute Wasserstein distance on each dimension, then average
        w_dist_dim1 = wasserstein_distance(baseline_projected[:, 0],
                                            prod_projected[:, 0])
        w_dist_dim2 = wasserstein_distance(baseline_projected[:, 1],
                                            prod_projected[:, 1])

        return (w_dist_dim1 + w_dist_dim2) / 2

    def detect_drift(self, production_samples: List[str]) -> Dict[str, any]:
        """
        Run all drift detection metrics and return comprehensive report.

        Returns dict with metrics and alert flags.
        """
        # Compute metrics
        kl_div = self.compute_kl_divergence(production_samples)
        psi = self.compute_psi(production_samples)
        embedding_drift = self.compute_embedding_drift(production_samples)

        # Define alert thresholds
        drift_detected = {
            "kl_divergence": {
                "value": kl_div,
                "threshold": 0.1,
                "alert": kl_div >= 0.1
            },
            "psi": {
                "value": psi,
                "threshold": 0.2,
                "alert": psi >= 0.2
            },
            "embedding_distance": {
                "value": embedding_drift,
                "threshold": 0.5,  # Application-specific
                "alert": embedding_drift >= 0.5
            }
        }

        # Overall drift status
        any_alert = any(metric["alert"] for metric in drift_detected.values())

        return {
            "drift_detected": any_alert,
            "metrics": drift_detected,
            "n_production_samples": len(production_samples),
            "n_baseline_samples": len(self.baseline_samples)
        }

# Example usage
if __name__ == "__main__":
    # Load baseline samples (from training data)
    baseline_samples = [
        "What is machine learning?",
        "Explain neural networks.",
        "How does gradient descent work?"
        # ... more representative training samples
    ]

    # Initialize detector
    from transformers import AutoModel, AutoTokenizer
    model = AutoModel.from_pretrained("gpt2")
    tokenizer = AutoTokenizer.from_pretrained("gpt2")

    detector = DriftDetector(baseline_samples, model, tokenizer)

    # Production samples (current week)
    production_samples = [
        "Tell me about ChatGPT",  # New concept not in training
        "What is GPT-4?",
        "Explain transformers"
        # ... current production queries
    ]

    # Detect drift
    report = detector.detect_drift(production_samples)

    if report["drift_detected"]:
        print("DRIFT ALERT: Distribution shift detected!")
        print(f"KL Divergence: {report['metrics']['kl_divergence']['value']:.4f}")
        print(f"PSI: {report['metrics']['psi']['value']:.4f}")
        print(f"Embedding Distance: {report['metrics']['embedding_distance']['value']:.4f}")
```

#strong[Detailed Code Walkthrough - Understanding Drift Detection]

#strong[\1. Class Design Philosophy - Why Three Metrics?]

The DriftDetector uses a multi-metric approach because different types
of drift require different detection methods:

- #strong[Token Distribution Drift (KL Divergence):] Detects when users
  start using different vocabulary. Example: Training data has
  \"coronavirus\", production has \"COVID-19\" or \"pandemic\".

- #strong[Statistical Drift (PSI):] Industry-standard metric from credit
  scoring, adapted for LLMs. Bins token frequencies and compares
  distributions statistically. Less sensitive to individual vocabulary
  changes, more sensitive to overall pattern shifts.

- #strong[Semantic Drift (Wasserstein Distance):] Operates in embedding
  space, capturing meaning shifts even when vocabulary is similar.
  Example: Training data about \"virus\" in biology context, production
  queries about \"virus\" in computer security context.

#strong[Real-world scenario:] A medical chatbot trained in 2019
(pre-COVID) would see:

- High KL divergence (new terms: \"mRNA vaccine\", \"long COVID\")

- High PSI (frequency patterns changed)

- High embedding distance (semantic shift from routine care to pandemic
  response)

#strong[\2. Initialization - Building the Baseline]

```python
def __init__(self, baseline_samples: List[str], model, tokenizer):
    self.baseline_samples = baseline_samples
    self.baseline_token_dist = self._compute_token_distribution(baseline_samples)
    self.baseline_embeddings = self._compute_embeddings(baseline_samples)
```

#strong[Why precompute baseline statistics?]

- Training distribution is fixed - compute once, reuse for all
  comparisons

- Saves computation: 1,000 baseline samples × 512 tokens = 512K token
  operations

- For weekly drift checks, this becomes: 512K (once) vs 52 × 512K
  (recompute every week)

- Memory cost: ~10-50MB for baseline stats vs hours of recomputation

#strong[Baseline sample selection strategy:]

+ #strong[Representativeness:] Sample proportionally from all training
  categories/topics

+ #strong[Size:] 1,000-10,000 samples (statistical significance:
  $n gt.eq 1000$ gives ±3% confidence)

+ #strong[Recency:] Use most recent training data if model retrained
  periodically

+ #strong[Stratification:] If training has imbalanced classes, use
  stratified sampling

#strong[Example baseline selection:]

```
Training data: 100K medical dialogues
- 40% routine checkups
- 30% chronic disease management
- 20% acute symptoms
- 10% medication questions

Baseline (1,000 samples):
- 400 routine checkups
- 300 chronic disease
- 200 acute symptoms
- 100 medication questions
```

#strong[\3. Token Distribution Computation - Frequency Analysis]

```python
def _compute_token_distribution(self, samples: List[str]) -> Dict[str, float]:
    token_counts = {}
    total_tokens = 0

    for sample in samples:
        tokens = self.tokenizer.tokenize(sample)
        for token in tokens:
            token_counts[token] = token_counts.get(token, 0) + 1
            total_tokens += 1

    token_dist = {token: count / total_tokens
                  for token, count in token_counts.items()}
    return token_dist
```

#strong[Mathematical foundation:]
$ P \( t o k e n_i \) = frac(c o u n t \( t o k e n_i \), sum_(j = 1)^V c o u n t \( t o k e n_j \)) $

Where $V$ is vocabulary size (typically 50K for GPT-2, 100K for GPT-3).

#strong[Why normalize to probabilities?]

- KL divergence requires probability distributions (sum to 1.0)

- Makes distributions comparable across different sample sizes

- Example: Baseline 10K samples, production 1K samples - probabilities
  still comparable

#strong[Efficiency consideration:] For 1,000 samples × 200 tokens
average = 200K token operations. Using Python dict (hash table): O(1)
lookup/insert → total O(200K) = 0.2 seconds on CPU.

#strong[\4. KL Divergence - Measuring Distribution Shift]

```python
def compute_kl_divergence(self, production_samples: List[str]) -> float:
    prod_dist = self._compute_token_distribution(production_samples)
    all_tokens = set(self.baseline_token_dist.keys()) | set(prod_dist.keys())

    smoothing = 1e-10
    kl_div = 0.0

    for token in all_tokens:
        p = self.baseline_token_dist.get(token, 0) + smoothing
        q = prod_dist.get(token, 0) + smoothing
        kl_div += p * np.log(p / q)

    return kl_div
```

#strong[Mathematical formulation:]
$ D_(K L) \( P parallel Q \) = sum_(i = 1)^V P \( t o k e n_i \) log frac(P \( t o k e n_i \), Q \( t o k e n_i \)) $

#strong[Why Laplace smoothing ($epsilon.alt = 10^(- 10)$)?]

- Problem: New tokens in production ($Q \( t o k e n \) = 0$) cause
  $log \( P \/ 0 \) = oo$

- Solution: Add small constant to avoid division by zero

- Why $10^(- 10)$ specifically? Large enough to prevent numerical
  issues, small enough to not distort probabilities (typical token
  probability $tilde.op 10^(- 4)$ to $10^(- 2)$)

#strong[Interpreting KL divergence values:]

- $D_(K L) < 0.05$: Negligible drift (normal day-to-day variation)

- $0.05 lt.eq D_(K L) < 0.1$: Minor drift (investigate but may not
  require action)

- $0.1 lt.eq D_(K L) < 0.5$: Significant drift (consider retraining)

- $D_(K L) gt.eq 0.5$: Severe drift (immediate investigation required)

#strong[Real-world example:]

```
Baseline (2019): "patient", "diagnosis", "treatment", "symptoms"
Production (2020): "COVID", "vaccine", "quarantine", "PCR test"

KL divergence: 0.35 (significant drift detected)
Action taken: Retrain on 2020 medical data
```

#strong[\5. PSI - Population Stability Index]

```python
def compute_psi(self, production_samples: List[str], n_bins: int = 10) -> float:
    # Get token frequency arrays
    baseline_freqs = np.array([self.baseline_token_dist.get(t, 0)
                                for t in all_tokens])
    prod_freqs = np.array([prod_dist.get(t, 0) for t in all_tokens])

    # Create bins and histogram
    bins = np.linspace(0, max(baseline_freqs.max(), prod_freqs.max()), n_bins + 1)
    baseline_binned, _ = np.histogram(baseline_freqs, bins=bins)
    prod_binned, _ = np.histogram(prod_freqs, bins=bins)

    # Normalize and compute PSI
    baseline_binned = baseline_binned / baseline_binned.sum()
    prod_binned = prod_binned / prod_binned.sum()

    psi = sum((prod_binned[i] - baseline_binned[i]) *
              np.log(prod_binned[i] / baseline_binned[i])
              for i in range(n_bins))
```

#strong[Mathematical foundation:]
$ P S I = sum_(i = 1)^(n_(b i n s)) \( P_(p r o d)^(\( i \)) - P_(b a s e l i n e)^(\( i \)) \) dot.op ln (P_(p r o d)^(\( i \)) / P_(b a s e l i n e)^(\( i \))) $

#strong[Why binning? (vs raw token probabilities)]

- #strong[Dimensionality reduction:] 50K vocabulary → 10 bins (5,000x
  reduction)

- #strong[Noise reduction:] Individual token fluctuations averaged out

- #strong[Interpretability:] Industry standard from credit scoring
  (decades of usage)

#strong[PSI interpretation (standard thresholds):]

- $P S I < 0.1$: No significant drift

- $0.1 lt.eq P S I < 0.2$: Moderate drift (monitor closely)

- $P S I gt.eq 0.2$: Severe drift (retraining recommended)

#strong[\6. Embedding Drift - Semantic Shift Detection]

```python
def compute_embedding_drift(self, production_samples: List[str]) -> float:
    prod_embeddings = self._compute_embeddings(production_samples)

    # PCA projection to 2D for computational efficiency
    all_embeddings = np.vstack([self.baseline_embeddings, prod_embeddings])
    pca = PCA(n_components=2)
    all_projected = pca.fit_transform(all_embeddings)

    # Compute Wasserstein distance on each dimension
    w_dist_dim1 = wasserstein_distance(baseline_projected[:, 0],
                                        prod_projected[:, 0])
    w_dist_dim2 = wasserstein_distance(baseline_projected[:, 1],
                                        prod_projected[:, 1])

    return (w_dist_dim1 + w_dist_dim2) / 2
```

#strong[Why Wasserstein distance? (vs Euclidean distance)]

- #strong[Distribution-aware:] Measures \"earth mover's distance\"
  between distributions

- #strong[Robust to outliers:] Doesn't penalize single extreme points
  heavily

- #strong[Interpretable:] Represents average distance points must
  \"move\" to transform one distribution to another

#strong[Why PCA to 2D? (vs full 768-dimensional embeddings)]

- #strong[Computational efficiency:] Wasserstein distance in high
  dimensions is O($n^2 log n dot.op d$), where $d$ is dimensionality

- 768D: $O \( 1000^2 log 1000 dot.op 768 \) approx 7$ billion operations

- 2D: $O \( 1000^2 log 1000 dot.op 2 \) approx 20$ million operations
  (350x speedup)

- #strong[Information retention:] Top 2 PCA components typically capture
  60-80% of variance (sufficient for drift detection)

#strong[Embedding drift interpretation:]

- Wasserstein distance \< 0.5: Semantic similarity maintained

- $0.5 lt.eq upright("distance") < 1.0$: Moderate semantic shift (new
  topics emerging)

- distance $gt.eq$ 1.0: Severe semantic drift (fundamentally different
  query types)

#strong[\7. Comprehensive Drift Report - Decision Making]

```python
def detect_drift(self, production_samples: List[str]) -> Dict[str, any]:
    kl_div = self.compute_kl_divergence(production_samples)
    psi = self.compute_psi(production_samples)
    embedding_drift = self.compute_embedding_drift(production_samples)

    drift_detected = {
        "kl_divergence": {"value": kl_div, "threshold": 0.1, "alert": kl_div >= 0.1},
        "psi": {"value": psi, "threshold": 0.2, "alert": psi >= 0.2},
        "embedding_distance": {"value": embedding_drift, "threshold": 0.5,
                                "alert": embedding_drift >= 0.5}
    }

    any_alert = any(metric["alert"] for metric in drift_detected.values())
    return {"drift_detected": any_alert, "metrics": drift_detected, ...}
```

