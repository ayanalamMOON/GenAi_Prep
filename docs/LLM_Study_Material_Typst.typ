#strong[Alert threshold decision tree:]

$ upright("Alert") = cases(delim: "{", upright("Critical") & upright("if ") Delta_(upright("acc")) > 10 % quad upright("(Model broken)"), upright("Warning") & upright("if ") 5 % < Delta_(upright("acc")) lt.eq 10 % quad upright("(Investigate)"), upright("None") & upright("if ") Delta_(upright("acc")) lt.eq 5 % quad upright("(Normal variance)")) $

