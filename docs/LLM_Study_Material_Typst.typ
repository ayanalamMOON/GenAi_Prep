# Step 5: Multi-Layer C-LoRA Model with Per-Layer Rank Adaptation
# This demonstrates how different layers learn different ranks

class MultiLayerCLoRAModel(nn.Module):
    """
    Example: 3-layer model where each layer learns its own optimal rank

    This mimics a simplified transformer where:
    - Layer 1: Early features (typically needs low rank)
    - Layer 2: Middle features (typically needs medium rank)
    - Layer 3: Late features (typically needs high rank)
    """

    def __init__(self, d_model: int = 768, rank: int = 16):
        super().__init__()

        self.layers = nn.ModuleList([
            TransformerLayerWithCLoRA(d_model, rank)
            for _ in range(3)
        ])

    def forward(self, x: torch.Tensor):
        gate_values_all = []

        for layer in self.layers:
            x, gate_values = layer(x)
            gate_values_all.append(gate_values)

        return x, gate_values_all

    def get_per_layer_ranks(self):
        """Get effective rank for each layer"""
        return [layer.clora.get_effective_rank() for layer in self.layers]

    def get_total_sparsity_loss(self, lambda_l1: float = 1e-4):
        """Sum sparsity loss across all layers"""
        total = sum(layer.clora.get_sparsity_loss(lambda_l1)
                   for layer in self.layers)
        return total

# Example usage showing per-layer rank adaptation
def demonstrate_per_layer_adaptation():
    """
    Show how different layers learn different ranks automatically
    """
    model = MultiLayerCLoRAModel(d_model=768, rank=16)

    # Simulate training (in practice, run actual training loop)
    # After training, inspect per-layer ranks

    print("\nPer-Layer Effective Ranks (After Training):")
