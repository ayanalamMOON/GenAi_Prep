=== Production Implementation: C-LoRA in PyTorch
<production-implementation-c-lora-in-pytorch>
#strong[From Pseudocode to Production:]

Now that we understand the high-level algorithm, let's implement
production-ready C-LoRA code. The implementation follows the pseudocode
structure but adds:

- Type hints and docstrings for clarity

- Error handling and validation

- Efficient GPU operations

- Monitoring hooks for debugging

#strong[Step 1: C-LoRA Layer Module]

A C-LoRA layer wraps a standard linear layer and adds:

+ Down-projection matrix $A$ (trainable)

+ Up-projection matrix $B$ (trainable)

+ Gating vector $upright(bold(g))$ (trainable, constrained to
  $\[ 0 \, 1 \]$)

+ Forward pass: Compute gated low-rank update

+ Sparsity regularization: Exposed for loss computation

#strong[Implementation with Extensive Comments:]

```python
# Step 1: Import Dependencies
# Purpose: PyTorch for neural networks, numpy for numerical operations

import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Optional, Tuple

# Step 2: Define C-LoRA Layer Class
# This layer wraps a frozen linear layer and adds learnable low-rank adaptation
# with continuous rank selection via gating vectors

class CLoRALayer(nn.Module):
    """
    Continuous LoRA (C-LoRA) Layer with Gradient-Flow-Based Rank Adaptation

    This layer implements adaptive rank selection by introducing a learnable
    gating vector g in [0,1]^r that controls which rank dimensions are active.

    Mathematical formulation:
        W' = W_frozen + A * diag(g) * B^T

    where:
        - W_frozen: Original frozen weight matrix (not updated)
        - A: Down-projection matrix (d x r), trainable
        - B: Up-projection matrix (k x r), trainable
        - g: Gating vector (r,), trainable, constrained to [0,1]
        - diag(g): Diagonal matrix with g on diagonal

    The effective rank is: r_eff = sum(g), which can be anywhere in [0, r]
    """

    def __init__(
        self,
        in_features: int,      # Input dimension (d)
        out_features: int,     # Output dimension (k)
        rank: int = 8,         # Maximum rank (r)
        alpha: float = 16.0,   # Scaling factor (same as LoRA)
        dropout: float = 0.0,  # Dropout probability
        use_sigmoid: bool = True  # Use sigmoid parameterization for gates
    ):
        super().__init__()

        # Store dimensions
        self.in_features = in_features
        self.out_features = out_features
        self.rank = rank
        self.alpha = alpha
        self.scaling = alpha / rank  # Scale factor for update magnitude
        self.use_sigmoid = use_sigmoid

        # Down-projection matrix A: d x r
        # Initialize with Kaiming uniform (same as LoRA)
        self.lora_A = nn.Parameter(torch.empty(rank, in_features))
        nn.init.kaiming_uniform_(self.lora_A, a=torch.sqrt(5))

        # Up-projection matrix B: k x r
        # Initialize to zero so initial update is zero (preserves pretrained model)
        self.lora_B = nn.Parameter(torch.zeros(out_features, rank))

        # Gating vector: r dimensions
        # Two parameterization options:

        if use_sigmoid:
            # Option 1: Sigmoid parameterization
            # Learn unconstrained z in R, compute g = sigmoid(z)
            # Initialize z to 0, giving g = 0.5 (maximum uncertainty initially)
            self.gate_logits = nn.Parameter(torch.zeros(rank))
            self.register_buffer('gate_values', None)  # Computed in forward
        else:
            # Option 2: Direct parameterization
            # Learn g directly in [0,1], use projection to enforce constraints
            # Initialize to 0.5 (uniform uncertainty)
            self.gate_values = nn.Parameter(torch.ones(rank) * 0.5)
            self.register_buffer('gate_logits', None)

        # Dropout for regularization (optional)
        self.dropout = nn.Dropout(p=dropout) if dropout > 0 else None
```

```python
def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        Forward pass with gated low-rank adaptation

        Args:
            x: Input tensor of shape (batch_size, seq_len, in_features)

        Returns:
            result: Output tensor of shape (batch_size, seq_len, out_features)
            gate_values: Current gate values (for monitoring/regularization)

        Mathematical flow:
            1. Compute gates: g = sigmoid(z) or directly use g
            2. Down-project: h = x @ A^T  (shape: batch x seq x r)
            3. Gate: h_gated = h * g  (element-wise, broadcasting)
            4. Up-project: delta = h_gated @ B^T  (shape: batch x seq x out)
            5. Scale: delta = delta * (alpha / r)
            6. Return: delta (to be added to base layer output)
        """

        # Step 1: Compute gate values
        if self.use_sigmoid:
            # Sigmoid parameterization: g = sigmoid(z)
            # This gives smooth gradients and automatic constraint satisfaction
            gate_values = torch.sigmoid(self.gate_logits)
        else:
            # Direct parameterization: use g directly
            # Clamp to [0,1] in case gradients pushed outside bounds
            gate_values = torch.clamp(self.gate_values, 0.0, 1.0)

        # Step 2: Apply dropout (optional, for regularization)
        if self.dropout is not None:
            x_drop = self.dropout(x)
        else:
            x_drop = x

        # Step 3: Down-projection through A
        # x_drop: (batch, seq, in_features)
        # lora_A: (rank, in_features)
        # Result: (batch, seq, rank)
        h = F.linear(x_drop, self.lora_A)

        # Step 4: Apply gating (element-wise multiplication)
        # h: (batch, seq, rank)
        # gate_values: (rank,)
        # Broadcasting: gate_values expands to (1, 1, rank), then multiplies
        # Result: (batch, seq, rank) with each rank dimension scaled by its gate
        h_gated = h * gate_values.unsqueeze(0).unsqueeze(0)

        # Step 5: Up-projection through B
        # h_gated: (batch, seq, rank)
        # lora_B: (out_features, rank)
        # Result: (batch, seq, out_features)
        delta_W = F.linear(h_gated, self.lora_B)

        # Step 6: Scale by alpha/rank (standard LoRA scaling)
        # This ensures update magnitude is independent of rank choice
        delta_W = delta_W * self.scaling

        # Return both the update and gate values (for sparsity loss)
        return delta_W, gate_values

    def get_effective_rank(self) -> float:
        """
        Compute effective rank: r_eff = sum(g)

        This tells us how many rank dimensions are actually being used.
        Example:
            g = [1.0, 0.9, 0.8, 0.1, 0.0, ...] -> r_eff = 2.8

        Returns:
            Effective rank as a float in [0, r]
        """
        if self.use_sigmoid:
            gate_values = torch.sigmoid(self.gate_logits)
        else:
            gate_values = torch.clamp(self.gate_values, 0.0, 1.0)

        return gate_values.sum().item()

    def get_sparsity_loss(self, lambda_l1: float = 1e-4) -> torch.Tensor:
        """
        Compute L1 sparsity regularization on gate values

        Loss = lambda * ||g||_1 = lambda * sum(|g_i|)

        This encourages gates to be near 0 (pruned) or 1 (active),
        avoiding wasteful partial activations around 0.5

        Args:
            lambda_l1: Sparsity penalty coefficient (typical: 1e-4 to 1e-3)

        Returns:
            Scalar tensor representing sparsity loss
        """
        if self.use_sigmoid:
            gate_values = torch.sigmoid(self.gate_logits)
        else:
            gate_values = torch.clamp(self.gate_values, 0.0, 1.0)

        # L1 norm: sum of absolute values (all gates are positive, so just sum)
        sparsity_loss = lambda_l1 * gate_values.sum()

        return sparsity_loss
```

```python
# Step 3: Example Usage - Wrapping a Linear Layer with C-LoRA
# This demonstrates how to replace a standard linear layer with C-LoRA

class TransformerLayerWithCLoRA(nn.Module):
    """
    Example: Single transformer attention layer with C-LoRA applied

    In a real transformer, you'd apply C-LoRA to Q, K, V projection matrices
    and potentially the output projection. This shows the pattern.
    """

    def __init__(
        self,
        d_model: int = 768,    # Model dimension (GPT-2 base)
        rank: int = 16,        # Maximum LoRA rank
        alpha: float = 32.0    # LoRA scaling (2x rank is common)
    ):
        super().__init__()

        # Frozen base layer (pretrained weights)
        # In practice, this would be loaded from a pretrained model
        self.base_layer = nn.Linear(d_model, d_model)
        self.base_layer.weight.requires_grad = False  # Freeze
        self.base_layer.bias.requires_grad = False

        # C-LoRA adaptation layer
        self.clora = CLoRALayer(
            in_features=d_model,
            out_features=d_model,
            rank=rank,
            alpha=alpha,
            dropout=0.05,
            use_sigmoid=True
        )

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        Forward pass: base layer + C-LoRA update

        Args:
            x: Input tensor (batch, seq, d_model)

        Returns:
            output: Combined output (batch, seq, d_model)
            gate_values: Gate values for this layer
        """
        # Base layer (frozen)
        base_output = self.base_layer(x)

        # C-LoRA update (adaptive rank)
        clora_update, gate_values = self.clora(x)

        # Combine: W' = W_frozen + Delta_W
        output = base_output + clora_update

        return output, gate_values

# Step 4: Training Loop with Sparsity Regularization
# This shows how to incorporate the sparsity loss into training

def train_clora_example():
    """
    Example training loop demonstrating:
    1. Forward pass through C-LoRA layer
    2. Task loss computation
    3. Sparsity loss computation
    4. Combined loss backpropagation
    5. Gate value monitoring
    """

    # Hyperparameters
    batch_size = 8
    seq_len = 128
    d_model = 768
    rank = 16
    learning_rate = 2e-5
    lambda_sparsity = 1e-4  # Sparsity penalty coefficient
    num_steps = 100

    # Create model
    model = TransformerLayerWithCLoRA(d_model=d_model, rank=rank)

    # Optimizer (only C-LoRA parameters are trainable)
    optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate)

    # Dummy data for demonstration
    # In practice, this would be real training data
    dummy_input = torch.randn(batch_size, seq_len, d_model)
    dummy_target = torch.randn(batch_size, seq_len, d_model)

    print("=" * 60)
    print("C-LoRA Training Example")
    print("=" * 60)
    print(f"Model dimension: {d_model}")
    print(f"Maximum rank: {rank}")
    print(f"Learning rate: {learning_rate}")
    print(f"Sparsity penalty (lambda): {lambda_sparsity}")
    print("=" * 60)

    # Training loop
    for step in range(num_steps):
        # Forward pass
        output, gate_values = model(dummy_input)

        # Task loss (example: MSE between output and target)
        # In practice, this would be cross-entropy for language modeling
        task_loss = F.mse_loss(output, dummy_target)

        # Sparsity loss (encourage gates toward 0 or 1)
        sparsity_loss = model.clora.get_sparsity_loss(lambda_sparsity)

        # Combined loss
        total_loss = task_loss + sparsity_loss

        # Backpropagation
        optimizer.zero_grad()
        total_loss.backward()
        optimizer.step()

        # Monitor progress every 10 steps
        if step % 10 == 0 or step == num_steps - 1:
            effective_rank = model.clora.get_effective_rank()

            print(f"\nStep {step:3d}:")
            print(f"  Task Loss:     {task_loss.item():.6f}")
            print(f"  Sparsity Loss: {sparsity_loss.item():.6f}")
            print(f"  Total Loss:    {total_loss.item():.6f}")
            print(f"  Effective Rank: {effective_rank:.2f} / {rank}")
            print(f"  Gate values: {gate_values.detach().cpu().numpy()}")

    print("\n" + "=" * 60)
    print("Training Complete!")
    print(f"Final Effective Rank: {model.clora.get_effective_rank():.2f}")
    print("=" * 60)
```

