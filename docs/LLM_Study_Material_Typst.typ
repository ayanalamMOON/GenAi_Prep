== Production PyTorch Implementation
<production-pytorch-implementation>
#strong[Step 1: Environment Setup and Dependencies]

This implementation demonstrates production-ready QAKD training. The
code is structured to be runnable and includes extensive comments
explaining the rationale behind every significant operation.

#strong[Architecture Overview:]

The implementation consists of:

+ `QAKDTrainer` class: Main training orchestrator

+ `FakeQuantization` layer: Simulates quantization during training

+ `AWQScaler`: Activation-aware weight scaling

+ Training loop with mixed-precision support

+ Monitoring utilities for debugging

```python
# Step 1: Install Dependencies
# Run this in your terminal before executing the script
# pip install torch transformers accelerate datasets bitsandbytes
# pip install auto-gptq  # For optional GPTQ post-processing

import torch
import torch.nn as nn
import torch.nn.functional as F
from transformers import AutoModelForCausalLM, AutoTokenizer
from torch.cuda.amp import autocast, GradScaler
import numpy as np
from typing import Optional, Dict, Tuple
from tqdm import tqdm
import wandb  # Optional: For experiment tracking

# Verify CUDA availability
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")
    print(f"Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB")


# Step 2: Fake Quantization Layer
class FakeQuantization(nn.Module):
    """
    Simulates quantization during forward pass but allows gradients
    to flow through in backward pass using straight-through estimator.

    Purpose: Train model to be robust to quantization noise WITHOUT
    actually deploying in low-precision until inference.
    """

    def __init__(self, bits: int = 4, symmetric: bool = True):
        super().__init__()
        self.bits = bits
        self.symmetric = symmetric
        self.n_levels = 2 ** bits  # INT4 = 16 levels, INT8 = 256 levels

        # Quantization parameters (learned during calibration)
        self.register_buffer('scale', torch.tensor(1.0))
        self.register_buffer('zero_point', torch.tensor(0.0))

    def calibrate(self, weight: torch.Tensor):
        """
        Compute quantization parameters from weight statistics.
        Called once before training starts.
        """
        w_min = weight.min().item()
        w_max = weight.max().item()

        if self.symmetric:
            # Symmetric: Range is [-alpha, alpha]
            alpha = max(abs(w_min), abs(w_max))
            self.scale = 2 * alpha / (self.n_levels - 1)
            self.zero_point = torch.tensor(0.0)
        else:
            # Asymmetric: Range is [w_min, w_max]
            self.scale = (w_max - w_min) / (self.n_levels - 1)
            self.zero_point = torch.tensor(w_min)

    def forward(self, weight: torch.Tensor) -> torch.Tensor:
        """
        Forward: Apply fake quantization
        Backward: Straight-through estimator (gradient flows as identity)
        """
        if not self.training:
            # During evaluation, return actual quantized weights
            return self.quantize(weight)

        # Training mode: Fake quantization with STE
        w_q = self.quantize(weight)

        # Straight-through estimator: Use quantized in forward,
        # but let gradients flow to original weights
        # This is the KEY trick: w_q in computation, but grad goes to weight
        return weight + (w_q - weight).detach()

    def quantize(self, weight: torch.Tensor) -> torch.Tensor:
        """
        Actual quantization operation: W_q = scale * round((W - zero_point) / scale)
        """
        # Step 1: Shift and scale to [0, n_levels-1]
        w_shifted = (weight - self.zero_point) / self.scale

        # Step 2: Round to nearest integer (quantization)
        w_quant_int = torch.round(w_shifted).clamp(0, self.n_levels - 1)

        # Step 3: Dequantize back to float (for computation)
        w_q = w_quant_int * self.scale + self.zero_point

        return w_q


# Step 3: AWQ (Activation-Aware Weight Quantization) Scaler
class AWQScaler:
    """
    Computes per-channel scaling factors based on activation magnitudes.
    Intuition: Weights with high activations need finer quantization.
    """

    def __init__(self, alpha: float = 0.5):
        self.alpha = alpha  # Scaling exponent (0.5 works well empirically)
        self.scales = {}    # Store scales per layer

    def calibrate(self, model: nn.Module, calibration_dataloader, device):
        """
        Run calibration data through model to collect activation statistics.

        Args:
            model: Student model
            calibration_dataloader: 500-1000 samples representative of deployment
            device: cuda or cpu
        """
        print("Running AWQ calibration...")
        model.eval()

        # Hooks to capture activations
        activations = {}

        def get_activation_hook(name):
            def hook(module, input, output):
                # Store absolute activation magnitudes
                if name not in activations:
                    activations[name] = []
                activations[name].append(input[0].abs().mean(dim=0).cpu())
            return hook

        # Register hooks on all linear layers
        hooks = []
        for name, module in model.named_modules():
            if isinstance(module, nn.Linear):
                hooks.append(module.register_forward_hook(
                    get_activation_hook(name)
                ))

        # Run calibration
        with torch.no_grad():
            for batch in tqdm(calibration_dataloader, desc="AWQ calibration"):
                input_ids = batch['input_ids'].to(device)
                model(input_ids)

        # Remove hooks
        for hook in hooks:
            hook.remove()

        # Compute per-channel scales
        for name, acts in activations.items():
            # Average over all calibration samples
            act_mean = torch.stack(acts).mean(dim=0)  # Shape: [hidden_dim]

            # Scale: s_i^alpha / max(s)
            s_max = act_mean.max()
            scale = (act_mean ** self.alpha) / (s_max ** self.alpha)

            self.scales[name] = scale.to(device)

        print(f"AWQ calibration complete. Scales computed for {len(self.scales)} layers.")
        model.train()

    def apply_scaling(self, name: str, weight: torch.Tensor) -> torch.Tensor:
        """
        Apply per-channel scaling to weight matrix.

        Args:
            name: Layer name (to look up scales)
            weight: Weight matrix [out_features, in_features]

        Returns:
            Scaled weight matrix
        """
        if name not in self.scales:
            return weight  # No scaling available

        scale = self.scales[name]

        # Broadcast scale across output dimension
        # Weight shape: [out_features, in_features]
        # Scale shape: [in_features] - need to unsqueeze to [1, in_features]
        return weight * scale.unsqueeze(0)


# Step 4: Main QAKD Trainer Class
class QAKDTrainer:
    """
    Complete QAKD training orchestrator combining:
    - Knowledge Distillation from teacher
    - Quantization-aware training with fake quantization
    - Optional AWQ scaling
    - Mixed-precision training with gradient scaling
    """

    def __init__(
        self,
        teacher_model: nn.Module,
        student_model: nn.Module,
        tokenizer,
        temperature: float = 3.0,
        lambda_quant: float = 5e-4,
        bits: int = 4,
        use_awq: bool = True,
        device: str = "cuda"
    ):
        self.teacher = teacher_model.to(device).eval()
        self.student = student_model.to(device)
        self.tokenizer = tokenizer
        self.temperature = temperature
        self.lambda_quant = lambda_quant
        self.bits = bits
        self.use_awq = use_awq
        self.device = device

        # Freeze teacher (only use for inference)
        for param in self.teacher.parameters():
            param.requires_grad = False

        # Setup fake quantization for all linear layers
        self.fake_quant_layers = {}
        self.original_weights = {}  # Store FP32 weights

        for name, module in self.student.named_modules():
            if isinstance(module, nn.Linear):
                # Create fake quantization layer
                fq = FakeQuantization(bits=bits).to(device)
                fq.calibrate(module.weight.data)
                self.fake_quant_layers[name] = fq

                # Store original weight reference
                self.original_weights[name] = module.weight

        # AWQ scaler (initialized in calibrate method)
        self.awq_scaler = AWQScaler() if use_awq else None

        # Mixed-precision training
        self.scaler = GradScaler()  # Automatic loss scaling

        print(f"QAKD Trainer initialized:")
        print(f"  Teacher: {sum(p.numel() for p in self.teacher.parameters()) / 1e9:.2f}B params")
        print(f"  Student: {sum(p.numel() for p in self.student.parameters()) / 1e9:.2f}B params")
        print(f"  Quantization: INT{bits}")
        print(f"  Temperature: {temperature}")
        print(f"  Lambda (quant penalty): {lambda_quant}")

    def calibrate_awq(self, calibration_dataloader):
        """Run AWQ calibration before training"""
        if self.use_awq and self.awq_scaler:
            self.awq_scaler.calibrate(
                self.student,
                calibration_dataloader,
                self.device
            )

    def apply_fake_quantization(self):
        """
        Apply fake quantization to all student weights.
        Called at the start of each forward pass.
        """
        for name, module in self.student.named_modules():
            if isinstance(module, nn.Linear) and name in self.fake_quant_layers:
                weight = module.weight  # FP32 weight

                # Optional: Apply AWQ scaling
                if self.use_awq and self.awq_scaler:
                    weight = self.awq_scaler.apply_scaling(name, weight)

                # Apply fake quantization with STE
                weight_q = self.fake_quant_layers[name](weight)

                # Replace module weight (temporarily, will revert after backward)
                module.weight.data = weight_q

    def compute_kd_loss(
        self,
        teacher_logits: torch.Tensor,
        student_logits: torch.Tensor
    ) -> torch.Tensor:
        """
        Knowledge Distillation loss: KL divergence between teacher and student.

        Formula: KL(p_T || p_S) = sum(p_T * log(p_T / p_S))
        Equivalent: CrossEntropy(p_T, p_S) * T^2

        Multiply by T^2 to offset the temperature scaling in softmax.
        """
        # Soft predictions with temperature
        p_teacher = F.softmax(teacher_logits / self.temperature, dim=-1)
        log_p_student = F.log_softmax(student_logits / self.temperature, dim=-1)

        # KL divergence
        kl_div = F.kl_div(
            log_p_student,
            p_teacher,
            reduction='batchmean'
        )

        # Scale by T^2 (standard practice in KD)
        return kl_div * (self.temperature ** 2)

    def compute_quant_loss(self) -> torch.Tensor:
        """
        Quantization noise regularization: sum of ||W_q - W||_F^2 across all layers.

        Intuition: Penalize weights that are far from their quantized values.
        This encourages the model to learn weight values that are "friendly"
        to quantization (e.g., clustered around quantization grid points).
        """
        total_quant_loss = 0.0

        for name, module in self.student.named_modules():
            if isinstance(module, nn.Linear) and name in self.original_weights:
                weight = self.original_weights[name]  # FP32 original
                weight_q = module.weight  # Quantized (from apply_fake_quantization)

                # Frobenius norm squared: sum of squared differences
                quant_error = torch.norm(weight_q - weight, p='fro') ** 2
                total_quant_loss += quant_error

        return total_quant_loss

    def train_step(
        self,
        batch: Dict[str, torch.Tensor],
        optimizer: torch.optim.Optimizer
    ) -> Dict[str, float]:
        """
        Single training step with mixed-precision and gradient accumulation support.

        Returns:
            Dictionary with loss components for monitoring
        """
        input_ids = batch['input_ids'].to(self.device)
        attention_mask = batch.get('attention_mask', None)
        if attention_mask is not None:
            attention_mask = attention_mask.to(self.device)

        # Teacher forward (full precision, no gradients)
        with torch.no_grad():
            teacher_outputs = self.teacher(
                input_ids=input_ids,
                attention_mask=attention_mask
            )
            teacher_logits = teacher_outputs.logits

        # Apply fake quantization to student weights
        self.apply_fake_quantization()

        # Student forward (mixed precision)
        with autocast():  # Automatic FP16 for speed
            student_outputs = self.student(
                input_ids=input_ids,
                attention_mask=attention_mask
            )
            student_logits = student_outputs.logits

            # Loss 1: Knowledge Distillation
            loss_kd = self.compute_kd_loss(teacher_logits, student_logits)

            # Loss 2: Quantization Noise Regularization
            loss_quant = self.compute_quant_loss()

            # Total loss
            loss_total = loss_kd + self.lambda_quant * loss_quant

        # Backward pass with automatic gradient scaling
        self.scaler.scale(loss_total).backward()

        # Gradient clipping (important for stability)
        self.scaler.unscale_(optimizer)
        torch.nn.utils.clip_grad_norm_(
            self.student.parameters(),
            max_norm=1.0
        )

        # Optimizer step with scaled gradients
        self.scaler.step(optimizer)
        self.scaler.update()
        optimizer.zero_grad()

        # Return loss components for logging
        return {
            'loss_total': loss_total.item(),
            'loss_kd': loss_kd.item(),
            'loss_quant': loss_quant.item(),
        }

    def train(
        self,
        train_dataloader,
        num_epochs: int = 3,
        learning_rate: float = 2e-5,
        log_every: int = 100,
        save_every: int = 1000,
        save_dir: str = "./qakd_checkpoints"
    ):
        """
        Full training loop with monitoring and checkpointing.
        """
        import os
        os.makedirs(save_dir, exist_ok=True)

        # Optimizer (AdamW with weight decay)
        optimizer = torch.optim.AdamW(
            self.student.parameters(),
            lr=learning_rate,
            betas=(0.9, 0.999),
            weight_decay=0.01  # Regularization
        )

        # Learning rate scheduler (cosine decay)
        total_steps = len(train_dataloader) * num_epochs
        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer,
            T_max=total_steps
        )

        global_step = 0
        self.student.train()

        for epoch in range(num_epochs):
            print(f"\n=== Epoch {epoch + 1}/{num_epochs} ===")

            epoch_losses = {'loss_total': [], 'loss_kd': [], 'loss_quant': []}

            progress_bar = tqdm(train_dataloader, desc=f"Epoch {epoch + 1}")
            for batch in progress_bar:
                global_step += 1

                # Training step
                losses = self.train_step(batch, optimizer)
                scheduler.step()

                # Accumulate for epoch average
                for k, v in losses.items():
                    epoch_losses[k].append(v)

                # Update progress bar
                progress_bar.set_postfix({
                    'loss': f"{losses['loss_total']:.4f}",
                    'kd': f"{losses['loss_kd']:.4f}",
                    'quant': f"{losses['loss_quant']:.6f}",
                    'lr': f"{scheduler.get_last_lr()[0]:.2e}"
                })

                # Logging
                if global_step % log_every == 0:
                    print(f"\nStep {global_step}:")
                    print(f"  KD Loss: {losses['loss_kd']:.4f}")
                    print(f"  Quant Loss: {losses['loss_quant']:.6f}")
                    print(f"  Total Loss: {losses['loss_total']:.4f}")

                    # Monitor per-layer quantization error
                    self._log_quantization_errors()

                # Checkpointing
                if global_step % save_every == 0:
                    checkpoint_path = os.path.join(
                        save_dir,
                        f"checkpoint_step_{global_step}.pt"
                    )
                    self.save_checkpoint(checkpoint_path)
                    print(f"  Saved checkpoint: {checkpoint_path}")

            # Epoch summary
            print(f"\nEpoch {epoch + 1} Summary:")
            for k, v in epoch_losses.items():
                print(f"  Average {k}: {np.mean(v):.4f}")

        # Save final model
        final_path = os.path.join(save_dir, "final_model.pt")
        self.save_checkpoint(final_path)
        print(f"\nTraining complete! Final model saved to {final_path}")

    def _log_quantization_errors(self):
        """Log per-layer quantization errors for debugging"""
        print("  Per-layer quantization errors:")
        for name, module in list(self.student.named_modules())[:5]:  # First 5 layers
            if isinstance(module, nn.Linear) and name in self.original_weights:
                weight = self.original_weights[name]
                weight_q = module.weight
                rel_error = (torch.norm(weight_q - weight) / torch.norm(weight)).item()
                print(f"    {name}: {rel_error:.4f}")

    def save_checkpoint(self, path: str):
        """Save model checkpoint"""
        torch.save({
            'student_state_dict': self.student.state_dict(),
            'fake_quant_layers': {k: v.state_dict() for k, v in self.fake_quant_layers.items()},
            'hyperparameters': {
                'temperature': self.temperature,
                'lambda_quant': self.lambda_quant,
                'bits': self.bits,
            }
        }, path)

    def load_checkpoint(self, path: str):
        """Load model checkpoint"""
        checkpoint = torch.load(path, map_location=self.device)
        self.student.load_state_dict(checkpoint['student_state_dict'])
        for name, state_dict in checkpoint['fake_quant_layers'].items():
            if name in self.fake_quant_layers:
                self.fake_quant_layers[name].load_state_dict(state_dict)
        print(f"Loaded checkpoint from {path}")


# Step 5: Usage Example
if __name__ == "__main__":
