$upright("goal") arrow.l upright("user_query")$
$upright("observation") arrow.l upright("null")$
$upright("thought") arrow.l upright("LLM") \( upright("goal") \, upright("observation") \)$
$upright("action") arrow.l upright("parse") \( upright("thought") \)$
$upright("answer")$
$upright("observation") arrow.l upright("execute") \( upright("action") \)$

]
